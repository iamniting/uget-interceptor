{
  "manifest_version": 3,
  "name": "uGet Download Interceptor",
  "short_name": "uGet Interceptor",
  "version": "1.0.0",
  "description": "Intercept Chrome downloads and send them to uGet using uget-integrator.",
  "minimum_chrome_version": "88",
  "key": "",
  "permissions": [
    "downloads",
    "storage",
    "nativeMessaging",
    "cookies",
    "notifications",
    "webRequest",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "uGet Download Interceptor",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png"
    }
  },
  "icons": {
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png"
  }
}
